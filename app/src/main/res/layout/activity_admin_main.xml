<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp">
    <EditText android:id="@+id/etSearch" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Search by name, code, phone, email" android:inputType="text" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/btnAdd" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Add" />
        <Button android:id="@+id/btnSalary" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Salary" />
        <Button android:id="@+id/btnLogout" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Logout" />
    </LinearLayout>
    <ListView android:id="@+id/lvEmployees" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
